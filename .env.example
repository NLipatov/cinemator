DOMAIN=watch.example.com
CINEMATOR_TAG=latest

# Optional. Leave empty to disable application-level password protection.
# Keep bcrypt hashes in single quotes so Compose preserves their $ characters.
CINEMATOR_PASSWORD_HASH=

# Required when password protection is enabled. Generate with: openssl rand -base64 32
# Use the same secret on every Cinemator instance behind the domain.
CINEMATOR_SESSION_SECRET=

# Disk budgets for small VPS hosts. Values are bytes.
CINEMATOR_MAX_TORRENT_CACHE_BYTES=12884901888
CINEMATOR_MAX_CACHE_BYTES=2147483648
CINEMATOR_TORRENT_READAHEAD_BYTES=536870912

# On-demand HLS generates this many 6-second segments from the playhead.
CINEMATOR_HLS_SEGMENT_SECONDS=6
CINEMATOR_HLS_WINDOW_SEGMENTS=5

# Limit concurrent video/subtitle FFmpeg jobs. Keep this at 1 on small VPS hosts.
CINEMATOR_MAX_TRANSCODES=1
